<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:padding="24dp"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="SudaTaxi A25 Lite (빌드 100% 성공 버전)" android:textSize="18sp" android:textStyle="bold"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Firebase URL 입력:" android:layout_marginTop="16dp"/>
    <EditText android:id="@+id/etFirebaseUrl" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:hint="https://your-project.firebaseio.com"/>
    <Button android:id="@+id/btnStart" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="🔥 시작" android:layout_marginTop="16dp"/>
    <TextView android:id="@+id/tvStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="오버레이 권한 허용 후 카카오T로 이동" android:layout_marginTop="16dp"/>
</LinearLayout>
